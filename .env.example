# Plantilla de configuración. Copie a `.env` y complete los valores.
# Este archivo se versiona: NUNCA escriba aquí secretos reales.

# PostgreSQL
POSTGRES_DB=sg_sst
POSTGRES_USER=sg_sst
POSTGRES_PASSWORD=cambie_esta_clave
# En desarrollo apunte al Postgres de docker-compose. Para un Postgres gestionado
# (Neon, RDS) use la cadena que entregue el proveedor, siempre con sslmode=require.
DATABASE_URL=postgresql://sg_sst:cambie_esta_clave@localhost:5432/sg_sst?schema=public

# API
API_PORT=3000
API_CORS_ORIGIN=http://localhost:4200
TRUST_PROXY_HOPS=1
NODE_ENV=development
AUDIT_ENABLED=true
# Genere cada secreto con: openssl rand -base64 48
JWT_ACCESS_SECRET=genere_un_secreto_unico_de_al_menos_32_bytes
JWT_REFRESH_SECRET=genere_otro_secreto_distinto_de_al_menos_32_bytes
SAFETY_TALK_JWT_SECRET=genere_un_tercer_secreto_distinto_de_al_menos_32_bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# R2 es opcional en desarrollo. Cuando las cuatro variables están presentes,
# se usa Cloudflare R2 en lugar del disco local. El bucket debe ser privado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Notificaciones push (opcional). Sin estas llaves los avisos quedan solo en la
# bandeja de la aplicación. Genérelas una vez con:
#   pnpm --filter @sg-sst/api exec web-push generate-vapid-keys
# Cambiar las llaves invalida las suscripciones de todos los dispositivos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sst@su-empresa.com
# Tarea horaria: vence permisos no iniciados y envía el resumen diario (6 a. m.).
NOTIFICATIONS_DIGEST_ENABLED=true

# Solo los usa `pnpm --filter @sg-sst/api run seed`. En producción cree el
# administrador mediante un procedimiento controlado y no deje estos valores fijos.
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
BOOTSTRAP_ADMIN_PASSWORD=cambie_esta_clave_de_bootstrap

# Frontend (usado por el build de Docker; el navegador accede a la API vía /api)
WEB_API_BASE_URL=/api

# Solo en el VPS (ver docs/DEPLOYMENT_AND_BACKUPS.md). IMAGE_TAG lo escribe
# scripts/deploy.sh en cada despliegue; no lo edite a mano.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# IMAGE_TAG=
